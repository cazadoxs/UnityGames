{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "mod",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "gameVersion": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModDependency"
      }
    },
    "loadAfter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "era": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changesRules": {
      "type": "boolean"
    }
  },
  "definitions": {
    "ModDependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
