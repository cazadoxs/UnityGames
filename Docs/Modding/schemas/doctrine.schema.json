{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "doctrine",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "float"
      }
    },
    "preferredPlans": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "float"
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
