<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compila Assets/_Project/Code/Core fuera de Unity con las mismas restricciones (netstandard2.1, C# 9). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Estandartes.Core</AssemblyName>
    <RootNamespace>Estandartes.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Estandartes/Assets/_Project/Code/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Misma versión que com.unity.nuget.newtonsoft-json 3.2.1 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
