<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ejecuta fuera de Unity las mismas pruebas EditMode del núcleo (Assets/_Project/Code/Tests/EditMode). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Estandartes/Assets/_Project/Code/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Estandartes.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
